#
# Salin file ini menjadi config/medirad.env (di-gitignore) lalu isi
# kredensial yang sebenarnya. File .env TIDAK boleh di-commit.

# Token auth API MediRad (JWT) — didapat dari server MediRad
MEDIRAD_TOKEN="GANTI_DENGAN_TOKEN_VALID"

# Base URL API MediRad (proxy SIMRS Banjar)
MEDIRAD_BASE_URL="https://radiologi.my.id/proxy-api-simrs"

# Lumi DICOM API lokal
LUMI_DICOM_URL="http://127.0.0.1:8765"
# Harus cocok dengan api.api_keys di config/default.yaml
LUMI_DICOM_API_KEY="lumi-dicom-dev-key"

# Interval polling dalam menit — 0 = hanya on-demand (--once)
FETCH_INTERVAL_MINUTES=5
